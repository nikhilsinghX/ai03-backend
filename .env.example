# Leave every key empty to run in MOCK mode (no API calls, rule-based demo logic).
# Fill ONE of them to use a real model. LLM_PROVIDER is optional: the first key found is used.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
MAX_FOLLOWUPS=2
MAX_CANDIDATE_TURNS=14
INTERVIEW_MINUTES=15
